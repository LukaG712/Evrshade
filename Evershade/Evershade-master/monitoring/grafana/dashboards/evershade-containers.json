        {
          "expr": "- rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
          "legendFormat": "TX - {{device}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
